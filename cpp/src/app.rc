#pragma code_page(65001)

// 简截 应用图标 + 版本信息
// 由 build_cpp.bat 用 rc.exe 编译成 app.res，再随目标文件一起链接。
// 注意：资源 ID 必须和 main.cpp 里的 IDI_APP 保持一致。

#define IDI_APP 101

IDI_APP ICON "../assets/icon.ico"

1 VERSIONINFO
 FILEVERSION    1,0,4,0
 PRODUCTVERSION 1,0,4,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "JianJie"
            VALUE "FileDescription",  "简截 - 微信风格截图工具"
            VALUE "FileVersion",      "1.0.4.0"
            VALUE "InternalName",     "JianJie"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
            VALUE "OriginalFilename", "简截.exe"
            VALUE "ProductName",      "简截"
            VALUE "ProductVersion",   "1.0.4.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
